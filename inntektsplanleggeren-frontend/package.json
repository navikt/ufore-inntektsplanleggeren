{
  "name": "inntektsplannleger-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/server/app.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail  \"vite \" \"node mock/server.cjs\"",
    "dev-q2": "concurrently --kill-others-on-fail  \"vite --mode development-q2 \" \"NODE_ENV=development npm run build:server && NODE_ENV=development NODE_TLS_REJECT_UNAUTHORIZED=0 node dist/server/server.js\"",
    "build": "tsc && vite build --mode development && npm run build:server",
    "build:development:veileder": "tsc && vite build --mode dev-veileder",
    "build:production": "tsc && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "@navikt/oasis": "^3.6.0",
    "dotenv": "16.4.7",
    "express": "^4.21.1",
    "express-prom-bundle": "^8.0.0",
    "http-proxy-middleware": "^3.0.3",
    "winston": "^3.17.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@navikt/aksel-icons": "^7.4.0",
    "@navikt/ds-css": "^7.4.0",
    "@navikt/ds-react": "^7.4.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.14.2",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "date-fns": "^3.6.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "highcharts": "^11.4.8",
    "highcharts-react-official": "^3.2.1",
    "openapi-typescript": "^7.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^6.26.1",
    "react-router-dom": "^6.26.1",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-config-standard-scss": "^11.0.0",
    "typescript": "^5.7.3",
    "vite": "^4.5.3",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-stylelint": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
