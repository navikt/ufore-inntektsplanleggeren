{
    "name": "inntektsplannleger-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "main": "src/server/app.js",
    "scripts": {
        "dev": "concurrently --kill-others-on-fail  \"vite \" \"node mock/server.cjs\"",
        "dev-veileder": "concurrently --kill-others-on-fail  \"vite --mode dev-veileder \" \"node mock/server.cjs\"",
        "dev-q2": "concurrently --kill-others-on-fail  \"vite --mode development-q2 \" \"nodemon --watch server/ --exec 'npm run build:server && NODE_ENV=development NODE_TLS_REJECT_UNAUTHORIZED=0 node dist/server/server.js'\"",
        "build": "tsc && vite build --mode development && npm run build:server",
        "build:development:veileder": "tsc && vite build --mode dev-veileder && npm run build:server",
        "build:production": "tsc && vite build && npm run build:server",
        "build:production:veileder": "tsc && vite build --mode production-veileder && npm run build:server",
        "build:server": "tsc -p tsconfig.server.json",
        "preview": "vite preview",
        "test": "vitest",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint ./src ./server",
        "lint:fix": "eslint --fix ./src ./server"
    },
    "dependencies": {
        "@navikt/oasis": "^3.7.0",
        "cors": "^2.8.5",
        "dotenv": "16.4.7",
        "express": "^4.21.2",
        "express-prom-bundle": "^8.0.0",
        "http-proxy-middleware": "^3.0.3",
        "unleash-client": "^6.6.0",
        "uuid": "^11.1.0",
        "winston": "^3.17.0"
    },
    "devDependencies": {
        "@navikt/aksel-icons": "^7.14.2",
        "@navikt/ds-css": "^7.14.2",
        "@navikt/ds-react": "^7.14.2",
        "@types/express": "^5.0.1",
        "@types/node": "^22.13.17",
        "@types/react": "^19.0.12",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react": "^4.3.4",
        "concurrently": "^9.1.2",
        "date-fns": "^4.1.0",
        "eslint": "^9.23.0",
        "eslint-config-prettier": "^10.1.1",
        "eslint-plugin-react": "^7.37.4",
        "highcharts": "^12.1.2",
        "highcharts-react-official": "^3.2.1",
        "nodemon": "^3.1.9",
        "openapi-typescript": "^7.6.1",
        "prettier": "^3.5.2",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-router": "^7.4.0",
        "react-router-dom": "^7.4.1",
        "stylelint-config-standard": "^37.0.0",
        "stylelint-config-standard-scss": "^14.0.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.29.0",
        "vite": "^6.2.4",
        "vite-plugin-eslint2": "^5.0.3",
        "vite-plugin-mock": "^3.0.2",
        "vite-plugin-stylelint": "^6.0.0",
        "vitest": "^3.1.1"
    }
}
